# --- Server ---
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# Public HTTPS URL Twilio/Vapi can reach (e.g. an ngrok tunnel in dev).
# Used to build absolute webhook URLs handed to Twilio/Vapi.
PUBLIC_BASE_URL=https://your-tunnel.ngrok.io

# --- Seed admin (created on first boot if the users table is empty) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately

# --- Twilio (required for calling) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API Key/Secret used to sign WebRTC Access Tokens (create under Console > Voice > API keys)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App whose Voice Request URL is set to {PUBLIC_BASE_URL}/api/voice/outbound
TWILIO_TWIML_APP_SID=
# A Twilio phone number in E.164 format, used as the caller ID for all outbound legs
TWILIO_CALLER_ID=

# --- Vapi AI assistant calling (optional — the "AI Assistant" dialer channel
#     stays hidden until these are set and an assistant/phone number are picked
#     in Admin Settings) ---
VAPI_API_KEY=
VAPI_BASE_URL=https://api.vapi.ai
# Shared secret configured alongside the assistant's Server URL in the Vapi
# dashboard, used to verify incoming webhook requests actually came from Vapi.
VAPI_SERVER_SECRET=
